{
  "name": "open-sharia-enterprise",
  "version": "1.0.0",
  "description": "Open source platform for researching and building trustworthy, Sharia-compliant enterprise products.",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test:quick",
    "lint": "nx run-many -t lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test:quick",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "nx": "nx",
    "prepare": "husky",
    "postinstall": "npm run doctor || true",
    "organiclever:dev": "docker compose --env-file infra/dev/organiclever-app/.env -f infra/dev/organiclever-app/docker-compose.yml up --build",
    "organiclever:dev:restart": "docker compose --env-file infra/dev/organiclever-app/.env -f infra/dev/organiclever-app/docker-compose.yml down -v && docker compose --env-file infra/dev/organiclever-app/.env -f infra/dev/organiclever-app/docker-compose.yml up --build",
    "dev:ayokoding-www": "docker compose -f infra/dev/ayokoding-www/docker-compose.yml up --build",
    "dev:ose-www": "docker compose -f infra/dev/ose-www/docker-compose.yml up --build",
    "dev:organiclever": "docker compose --env-file infra/dev/organiclever-app/.env -f infra/dev/organiclever-app/docker-compose.yml up --build",
    "generate:bindings": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness bindings generate",
    "sync:agents": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness bindings generate --harness opencode",
    "sync:skills": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness bindings generate --harness opencode",
    "sync:dry-run": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness bindings generate --harness opencode --dry-run",
    "validate:sync": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness sync validate",
    "validate:claude": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness claude validate",
    "validate:opencode": "npm run validate:sync",
    "validate:config": "npm run validate:claude && npm run generate:bindings && npm run validate:opencode",
    "harness:bindings-validation": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- harness bindings validate",
    "doctor": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- doctor"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "volta": {
    "node": "24.16.0",
    "npm": "11.11.0"
  },
  "devDependencies": {
    "@bazel/buildifier": "8.2.1",
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@hey-api/openapi-ts": "0.94.2",
    "@johnnymorganz/stylua-bin": "2.5.2",
    "@openapitools/openapi-generator-cli": "2.30.2",
    "@redocly/cli": "2.22.1",
    "@stoplight/spectral-cli": "6.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "29.0.0",
    "lint-staged": "16.4.0",
    "markdownlint-cli2": "0.21.0",
    "nx": "22.5.4",
    "oxlint": "1.78.0",
    "prettier": "3.8.1",
    "prettier-plugin-sql": "0.20.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tsx": "4.21.0"
  },
  "lint-staged": {
    "repo-config.yml": [
      "bash -c 'apps/rhino-cli/scripts/rhino-bin.sh repo-config validate' --"
    ],
    "*.md": [
      "node_modules/.bin/prettier --write",
      "node_modules/.bin/markdownlint-cli2",
      "apps/rhino-cli/scripts/rhino-bin.sh md mermaid validate --exclude \"apps/rhino-cli/tests/fixtures\" --exclude \"plans/done\" --exclude \"apps/ayokoding-www/content\"",
      "apps/rhino-cli/scripts/rhino-bin.sh md heading-hierarchy validate",
      "apps/rhino-cli/scripts/rhino-bin.sh md naming validate --exempt \"*__linkedin__*.md\" --exempt \"CONTRIBUTING.md\"",
      "apps/rhino-cli/scripts/rhino-bin.sh md frontmatter validate"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node_modules/.bin/prettier --write"
    ],
    "*.json": [
      "node_modules/.bin/prettier --write"
    ],
    "*.{yml,yaml}": [
      "node_modules/.bin/prettier --write"
    ],
    "*.{css,scss}": [
      "node_modules/.bin/prettier --write"
    ],
    "*.html": [
      "node_modules/.bin/prettier --write"
    ],
    "*.sql": [
      "node_modules/.bin/prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2024"
    ],
    "*.fs": [
      "fantomas"
    ],
    "*.py": [
      "ruff format"
    ],
    "*.go": [
      "gofmt -w"
    ],
    "*.{ex,exs}": [
      "scripts/format-elixir.sh"
    ],
    "*.cs": [
      "dotnet csharpier format"
    ],
    "*.dart": [
      "dart format"
    ],
    "*.sh": [
      "shfmt -w",
      "shellcheck --severity=warning"
    ],
    "*.tf": [
      "tofu fmt"
    ],
    "*.lua": [
      "stylua"
    ],
    "*.{c,h}": [
      "clang-format -i"
    ],
    "{BUILD,BUILD.bazel,*.bzl}": [
      "buildifier"
    ],
    ".github/workflows/*.{yml,yaml}": [
      "actionlint"
    ],
    "**/Dockerfile*": [
      "sh -ec 'for f; do [ ! -e \"$f\" ] || hadolint --failure-threshold warning \"$f\"; done' --"
    ],
    "*.{json,toml,ts,tsx,js,jsx,mjs,cjs,rs,go,py,cs,clj,dart,ex,exs,fs}": [
      "apps/rhino-cli/scripts/rhino-bin.sh convention emoji validate"
    ],
    "*.feature": [
      "apps/rhino-cli/scripts/rhino-bin.sh specs gherkin-cardinality validate"
    ],
    "docker-compose*.{yml,yaml}": [
      "bash -c 'set -e; for f; do base=${f%.ci.yml}.yml; if [ \"$base\" != \"$f\" ] && [ -f \"$base\" ]; then docker compose -f \"$base\" -f \"$f\" config > /dev/null; else docker compose -f \"$f\" config > /dev/null; fi; done' --"
    ]
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "tailwindcss": "4.2.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.0",
    "@next/swc-linux-x64-gnu": "16.2.6",
    "@next/swc-linux-x64-musl": "16.2.6",
    "@nx/nx-linux-x64-gnu": "22.5.4",
    "@nx/nx-linux-x64-musl": "22.5.4",
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "@tailwindcss/oxide-linux-x64-musl": "4.2.1",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  }
}
