{
  "name": "rust-commons",
  "sourceRoot": "libs/rust-commons",
  "projectType": "library",
  "tags": ["type:lib", "platform:cli", "lang:rust", "domain:tooling"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --manifest-path libs/rust-commons/Cargo.toml"
      },
      "outputs": []
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --manifest-path libs/rust-commons/Cargo.toml"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt --manifest-path libs/rust-commons/Cargo.toml -- --check",
          "cargo clippy --manifest-path libs/rust-commons/Cargo.toml --all-targets -- -D warnings"
        ],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path libs/rust-commons/Cargo.toml --all-targets"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path libs/rust-commons/Cargo.toml --lib --test check_links"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/tests/**/*.rs",
        "{workspaceRoot}/specs/libs/rust-commons/behavior/gherkin/**/*.feature"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo llvm-cov --manifest-path libs/rust-commons/Cargo.toml --lib --fail-under-lines 90"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"],
      "outputs": ["{projectRoot}/lcov.info"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run rust-commons:typecheck",
          "npx nx run rust-commons:lint",
          "npx nx run rust-commons:test:unit",
          "npx nx run rust-commons:test:coverage",
          "npx nx run rust-commons:test:specs"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs behavior-coverage validate specs/libs/rust-commons/behavior/gherkin libs/rust-commons"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/libs/rust-commons/behavior/gherkin/**/*.feature",
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/tests/**/*.rs"
      ]
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs counts validate specs/libs/rust-commons"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/rust-commons/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run rust-commons:specs:structure-validation",
          "npx nx run rust-commons:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/rust-commons/**/*", "{projectRoot}/src/**/*.rs", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'deps:audit: rust-commons is a workspace library; audited via cargo deny on consumers (rhino-cli, ayokoding-cli, ose-cli)'"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo hack --manifest-path libs/rust-commons/Cargo.toml check --rust-version"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/rust-commons/behavior/gherkin/**/*.feature"]
  }
}
