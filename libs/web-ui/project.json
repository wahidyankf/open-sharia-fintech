{
  "name": "web-ui",
  "sourceRoot": "libs/web-ui/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/web-ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin .",
        "cwd": "libs/web-ui"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --coverage",
        "cwd": "libs/web-ui"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --coverage --coverage.thresholds.lines=70",
        "cwd": "libs/web-ui"
      },
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run web-ui:typecheck",
          "npx nx run web-ui:lint",
          "npx nx run web-ui:test:unit",
          "npx nx run web-ui:test:coverage",
          "npx nx run web-ui:test:specs"
        ],
        "parallel": false
      },
      "inputs": ["default", "specs"]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev -p 6006 --no-open",
        "cwd": "libs/web-ui"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npx storybook build -o storybook-static",
        "cwd": "libs/web-ui"
      },
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "test:visual": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config e2e/playwright.config.ts",
        "cwd": "libs/web-ui"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs behavior-coverage validate specs/libs/web-ui/behavior/gherkin libs/web-ui"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui/behavior/gherkin/**/*.feature", "{projectRoot}/src/**/*.{ts,tsx}"]
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs counts validate specs/libs/web-ui"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx nx run web-ui:specs:structure-validation", "npx nx run web-ui:specs:behavior:coverage"],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui/**/*", "{projectRoot}/src/**/*.{ts,tsx}", "specs"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/web-ui/behavior/gherkin/**/*.feature"]
  },
  "tags": ["type:lib", "lang:ts", "domain:ui"]
}
