{
  "name": "web-ui-token",
  "sourceRoot": "libs/web-ui-token/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/web-ui-token"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No lint configured for web-ui-token (CSS + minimal TS)'"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx vitest run",
          "! grep -rnE '\\.(skip|todo)\\(' --include='*.test.*' --include='*.steps.*' src"
        ],
        "parallel": false,
        "cwd": "libs/web-ui-token"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
        "cwd": "libs/web-ui-token"
      },
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate specs/libs/web-ui-token/behaviors libs/web-ui-token"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/behaviors/**/*.feature", "{projectRoot}/src/**/*"]
    },
    "test:behavior:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project web-ui-token --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/libs/web-ui-token/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project web-ui-token --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/libs/web-ui-token/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project web-ui-token --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/libs/web-ui-token/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run web-ui-token:test:behavior:coverage:unit",
          "npx nx run web-ui-token:test:behavior:coverage:integration",
          "npx nx run web-ui-token:test:behavior:coverage:e2e"
        ],
        "parallel": false
      },
      "dependsOn": ["test:behavior:coverage:unit", "test:behavior:coverage:integration", "test:behavior:coverage:e2e"],
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs counts validate specs/libs/web-ui-token"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run web-ui-token:specs:structure-validation",
          "npx nx run web-ui-token:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/**/*", "{projectRoot}/src/**/*", "specs"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run web-ui-token:typecheck",
          "npx nx run web-ui-token:lint",
          "npx nx run web-ui-token:test:unit",
          "npx nx run web-ui-token:test:coverage",
          "npx nx run web-ui-token:test:specs",
          "npx nx run web-ui-token:test:layout:validation",
          "npx nx run web-ui-token:coverage:policy:validation",
          "npx nx run web-ui-token:package-manifest:policy:validation"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "test:layout:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract layout validate --project web-ui-token"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "coverage:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract coverage validate --project web-ui-token"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "package-manifest:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract manifest validate --project web-ui-token"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/web-ui-token/behaviors/**/*.feature"]
  },
  "tags": ["type:lib", "lang:ts", "domain:ui"]
}
