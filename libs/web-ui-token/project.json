{
  "name": "web-ui-token",
  "sourceRoot": "libs/web-ui-token/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "libs/web-ui-token"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No lint configured for web-ui-token (CSS + minimal TS)'"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx vitest run",
          "! grep -rnE '\\.(skip|todo)\\(' --include='*.test.*' --include='*.steps.*' src"
        ],
        "parallel": false,
        "cwd": "libs/web-ui-token"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'test:coverage: @vitest/coverage-v8 omitted deliberately — mirrors the ts-ui-tokens npm-hoisting-regression finding in the sibling repos; the single real vitest-cucumber scenario already exercises 100% of this token-export lib (echo placeholder)'",
        "cwd": "libs/web-ui-token"
      },
      "cache": true
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate specs/libs/web-ui-token/behavior/gherkin libs/web-ui-token"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/behavior/gherkin/**/*.feature", "{projectRoot}/src/**/*"]
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs counts validate specs/libs/web-ui-token"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run web-ui-token:specs:structure-validation",
          "npx nx run web-ui-token:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/libs/web-ui-token/**/*", "{projectRoot}/src/**/*", "specs"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run web-ui-token:typecheck",
          "npx nx run web-ui-token:lint",
          "npx nx run web-ui-token:test:unit",
          "npx nx run web-ui-token:test:coverage",
          "npx nx run web-ui-token:test:specs"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/libs/web-ui-token/behavior/gherkin/**/*.feature"]
  },
  "tags": ["type:lib", "lang:ts", "domain:ui"]
}
