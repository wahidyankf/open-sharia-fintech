FROM mcr.microsoft.com/dotnet/sdk:10.0.302-noble@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0

# curl is required by the compose healthcheck (the SDK image does not ship it).
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["dotnet", "watch", "run", "--project", "src/BeaverNestBe/BeaverNestBe.fsproj"]
