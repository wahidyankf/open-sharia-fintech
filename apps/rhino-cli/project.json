{
  "name": "rhino-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/rhino-cli/src",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:fsharp", "domain:tooling"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -c Release --self-contained {args.selfContained} {args.rid} -o apps/rhino-cli/src/dist",
        "rid": "--use-current-runtime",
        "selfContained": true
      },
      "outputs": ["{projectRoot}/src/dist"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet restore apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj --no-restore"
      },
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check apps/rhino-cli/src",
          "for p in RhinoCli.Domain RhinoCli.Infrastructure RhinoCli.Application RhinoCli.Cli RhinoCli.Program; do dotnet fsharplint lint apps/rhino-cli/src/$p/$p.fsproj --lint-config apps/rhino-cli/src/fsharplint.json || exit 1; done",
          "ANALYZERS_PATH=$(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1); for p in RhinoCli.Domain RhinoCli.Infrastructure RhinoCli.Application RhinoCli.Cli RhinoCli.Program; do dotnet fsharp-analyzers --project apps/rhino-cli/src/$p/$p.fsproj --analyzers-path \"$ANALYZERS_PATH\" --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001 || exit 1; done"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/dotnet-deps-audit.sh apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj --"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=\\s*\"' apps/rhino-cli/tests/integration; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR dotnet test apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj"
      },
      "cache": false
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=\\s*\"' apps/rhino-cli/tests/e2e; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR dotnet test apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      },
      "cache": false
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run rhino-cli:typecheck",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:lint",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:test:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:specs:structure-validation",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:test:coverage",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=\\s*\"' apps/rhino-cli/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && node scripts/dotnet-unit-coverage.mjs --project apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj --results apps/rhino-cli/tests/unit/coverage --line-threshold 99 --exclude-by-file '**/GitRoot.fs' --exclude-by-file '**/Parity.fs' --exclude-by-file '**/Dispatch.fs' --exclude-by-file '**/HarnessRuntime.fs' --exclude-by-file '**/DoctorResource.fs'"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{workspaceRoot}/scripts/dotnet-unit-coverage.mjs",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature"
      ],
      "outputs": ["{projectRoot}/tests/unit/coverage/coverage.cobertura.xml"]
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "governance:vendor-audit-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- repo-governance vendor validate repo-governance/"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/repo-governance/**/*.md"]
    },
    "governance-word-budget:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- governance word-budget validate"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md"
      ]
    },
    "governance-readme-index:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- governance readme-index validate"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/repo-governance/**/*.md"]
    },
    "env:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- env validate"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/apps/**/.env.example",
        "{workspaceRoot}/apps/*/src/env.ts",
        "{workspaceRoot}/apps/*/src/**/*.rs"
      ]
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/rhino-cli/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    },
    "test:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/rhino-cli/behaviour-coverage.json --adapter integration"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/rhino-cli/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/rhino-cli/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "npm exec -- nx run rhino-cli:test:coverage:unit",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:test:coverage:integration",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:test:coverage:e2e",
            "forwardAllArgs": false
          },
          {
            "command": "npm exec -- nx run rhino-cli:test:coverage:behaviour",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/rhino-cli/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/**/*.{ts,tsx,fs}",
        "{workspaceRoot}/apps/rhino-cli/tests/e2e/RhinoCli.E2ETests.fsproj"
      ]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/rhino/cli/behaviours/**/*.feature"]
  }
}
