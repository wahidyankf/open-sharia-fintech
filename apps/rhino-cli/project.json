{
  "name": "rhino-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/rhino-cli/src",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:fsharp", "domain:tooling"],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -c Release --self-contained true {args.rid} -o apps/rhino-cli/src/dist",
        "rid": "--use-current-runtime"
      },
      "outputs": ["{projectRoot}/src/dist"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet restore apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj --no-restore"
      },
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check apps/rhino-cli/src",
          "for p in RhinoCli.Domain RhinoCli.Infrastructure RhinoCli.Application RhinoCli.Cli RhinoCli.Program; do dotnet fsharplint lint apps/rhino-cli/src/$p/$p.fsproj --lint-config apps/rhino-cli/src/fsharplint.json || exit 1; done",
          "ANALYZERS_PATH=$(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1); for p in RhinoCli.Domain RhinoCli.Infrastructure RhinoCli.Application RhinoCli.Cli RhinoCli.Program; do dotnet fsharp-analyzers --project apps/rhino-cli/src/$p/$p.fsproj --analyzers-path \"$ANALYZERS_PATH\" --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001 || exit 1; done"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/**/*.fsproj"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/dotnet-deps-audit.sh apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj --"
      }
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps specs/apps/rhino/cli/behaviors apps/rhino-cli"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature",
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/**/*.fs"
      ]
    },
    "test:behavior:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- test-contract bdd validate --project rhino-cli --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/**/*.fs"
      ]
    },
    "test:behavior:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- test-contract bdd validate --project rhino-cli --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/**/*.fs"
      ]
    },
    "test:behavior:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- test-contract bdd validate --project rhino-cli --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/**/*.fs"
      ]
    },
    "test:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run rhino-cli:test:behavior:coverage:unit",
          "npx nx run rhino-cli:test:behavior:coverage:integration",
          "npx nx run rhino-cli:test:behavior:coverage:e2e"
        ],
        "parallel": false
      },
      "dependsOn": ["test:behavior:coverage:unit", "test:behavior:coverage:integration", "test:behavior:coverage:e2e"],
      "cache": true
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=\\s*\"' apps/rhino-cli/tests/integration; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR dotnet test apps/rhino-cli/tests/integration/RhinoCli.IntegrationTests.fsproj"
      },
      "cache": false
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR dotnet test apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj /p:CollectCoverage=true /p:Threshold=99 /p:ThresholdType=line \"/p:ExcludeByFile=**/RhinoCli.Program/src/Program.fs\""
      },
      "cache": false,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/tests/unit/**/*.fs"],
      "outputs": ["{projectRoot}/tests/unit/coverage.json"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run rhino-cli:typecheck",
          "npx nx run rhino-cli:lint",
          "npx nx run rhino-cli:test:unit",
          "npx nx run rhino-cli:test:coverage",
          "npx nx run rhino-cli:test:specs",
          "npx nx run rhino-cli:test:layout:validation",
          "npx nx run rhino-cli:coverage:policy:validation",
          "npx nx run rhino-cli:package-manifest:policy:validation"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck", "lint"],
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=\\s*\"' apps/rhino-cli/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR dotnet test apps/rhino-cli/tests/unit/RhinoCli.UnitTests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature"
      ]
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx nx run rhino-cli:specs:structure-validation", "npx nx run rhino-cli:specs:behavior:coverage"],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "specs:gherkin-cardinality-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs gherkin-cardinality validate"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/specs/**/*.feature"]
    },
    "governance:vendor-audit-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- repo-governance vendor validate repo-governance/"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/repo-governance/**/*.md"]
    },
    "governance-word-budget:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- governance word-budget validate"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md"
      ]
    },
    "governance-readme-index:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- governance readme-index validate"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{workspaceRoot}/repo-governance/**/*.md"]
    },
    "env:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- env validate"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{workspaceRoot}/repo-config.yml",
        "{workspaceRoot}/apps/**/.env.example",
        "{workspaceRoot}/apps/*/src/env.ts",
        "{workspaceRoot}/apps/*/src/**/*.rs"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:layout:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract layout validate --project rhino-cli"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "coverage:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract coverage validate --project rhino-cli"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "package-manifest:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract manifest validate --project rhino-cli"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/rhino/cli/behaviors/**/*.feature"]
  }
}
