<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RhinoCli.Tests.Integration</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 3261/3264: F# nullness interop noise in test data. -->
    <OtherFlags>--nowarn:3261 --nowarn:3264</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Steps/PreCommitHookSteps.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TickSpec" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RhinoCli.Cli/RhinoCli.Cli.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Application/RhinoCli.Application.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Domain/RhinoCli.Domain.fsproj" />
    <ProjectReference Include="../../src/RhinoCli.Infrastructure/RhinoCli.Infrastructure.fsproj" />
  </ItemGroup>
</Project>
