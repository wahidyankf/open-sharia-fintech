{
  "schema": "ose-test-contract-closure-fixture/v1",
  "purpose": "A permanent regression guard for the eight finite test-contract concerns closed out by Phase 20B of the adopt-beavernest-test-automation plan. Every section below is a deliberately-invalid case; the corresponding TestContractClosureUnitTests.fs fact proves the real validator still rejects it.",
  "registry": {
    "concern": "registry",
    "validator": "RhinoCli.Application.TestContract.validate",
    "case": "the canonical testing root declares a schema version other than the exact literal the strict reader selects on",
    "field": "testing.schema",
    "project": "closure-owner",
    "invalid-value": "ose-test-contract/v2",
    "expected-diagnostic": "testing.schema: expected \"ose-test-contract/v1\", found \"ose-test-contract/v2\""
  },
  "lifecycle": {
    "concern": "lifecycle",
    "validator": "RhinoCli.Application.TestContract.validate",
    "case": "an active owner row still declares a bootstrap seed target after activation",
    "field": "behavior.seed",
    "project": "closure-owner",
    "invalid-value": "test:behavior:seed",
    "expected-diagnostic": "behavior.seed: closure-owner is active but still declares the seed target \"test:behavior:seed\""
  },
  "corpus": {
    "concern": "corpus",
    "validator": "RhinoCli.Application.TestContract.validate",
    "case": "an active owner row resolves an empty corpus instead of a non-empty glob list",
    "field": "behavior.corpus",
    "project": "closure-owner",
    "invalid-value": [],
    "expected-diagnostic": "behavior.corpus: closure-owner is an active owner and must resolve a non-empty corpus"
  },
  "target-composition": {
    "concern": "target-composition",
    "validator": "RhinoCli.Application.TestContract.validate",
    "case": "a required adapter is hosted by a project other than the row's own owning project",
    "field": "behavior.adapters.unit.project",
    "project": "closure-owner",
    "invalid-value": "unrelated-project",
    "expected-diagnostic": "behavior.adapters.unit.project: closure-owner must host its own required adapter, found \"unrelated-project\""
  },
  "layout": {
    "concern": "layout",
    "validator": "RhinoCli.Application.TestContractLayout.validateDocument",
    "case": "an executable test file left in src/ has no owned layer at all",
    "source-fixture": "apps/rhino-cli/tests/unit/Fixtures/TestContract/Layout/executable-test-in-src.json",
    "expected-diagnostic": "layout-test-in-forbidden-directory",
    "document": {
      "schema": "ose-test-contract-layout-fixture/v1",
      "case": "an executable test left in src/ has no layer at all",
      "project": "widget-app",
      "owner": "widget-app",
      "root": "apps/widget-app",
      "ownedLayers": ["unit"],
      "directories": ["apps/widget-app/tests/unit"],
      "files": [
        { "path": "apps/widget-app/tests/unit/core.test.ts", "executable": true, "selectedBy": ["test:unit"] },
        { "path": "apps/widget-app/src/widget/legacy.test.ts", "executable": true, "selectedBy": ["test:unit"] }
      ]
    }
  },
  "manifest": {
    "concern": "manifest",
    "validator": "RhinoCli.Application.TestContractManifest.validateDocument",
    "case": "a retained manifest names no direct consumer",
    "source-fixture": "apps/rhino-cli/tests/unit/Fixtures/TestContract/Manifest/retained-without-consumer.json",
    "expected-diagnostic": "manifest-retained-without-consumer",
    "document": {
      "schema": "ose-test-contract-manifest-fixture/v1",
      "case": "a retained manifest with no named direct consumer",
      "project": "widget-www",
      "owner": "widget-www",
      "group": "web-application",
      "disposition": "retained",
      "manifestPath": "apps/widget-www/package.json",
      "consumer": null,
      "requiredFields": ["name", "version"],
      "verification": "npm install --workspace apps/widget-www",
      "scripts": [],
      "commands": []
    }
  },
  "coverage": {
    "concern": "coverage",
    "validator": "RhinoCli.Application.TestContractCoverage.validateDocument",
    "case": "a measured slice at 98 of 100 lines is below the 99 floor",
    "source-fixture": "apps/rhino-cli/tests/unit/Fixtures/TestContract/Coverage/98-percent.json",
    "expected-diagnostic": "coverage-below-floor",
    "document": {
      "schema": "ose-test-contract-coverage-fixture/v1",
      "case": "a measured slice at 98 of 100 lines is below the 99 floor",
      "project": "widget-app",
      "owner": "widget-app",
      "adapter": "unit",
      "profile": "measured",
      "reason": null,
      "thresholds": [{ "source": "project.json:coverage.lines", "value": 99 }],
      "target": { "name": "test:unit", "command": "dotnet test widget-app.Tests --collect:\"XPlat Code Coverage\"" },
      "exclusions": [],
      "slices": [
        {
          "path": "src/widget/core.fs",
          "applicable": true,
          "measured": true,
          "covered": 98,
          "total": 100,
          "output": "coverage/unit/core"
        }
      ]
    }
  },
  "bdd": {
    "concern": "bdd",
    "validator": "RhinoCli.Application.TestContractBdd.validateDocument",
    "case": "a scenario without an explicit When step is missing a required keyword",
    "source-fixture": "apps/rhino-cli/tests/unit/Fixtures/TestContract/Bdd/missing-step.json",
    "expected-diagnostic": "bdd-missing-required-keyword",
    "document": {
      "schema": "ose-test-contract-bdd-fixture/v1",
      "case": "missing-step",
      "project": "widget-app",
      "owner": "widget-app",
      "adapter": "unit",
      "disposition": "required",
      "driver": "apps/widget-app/src/testing/bdd/unit-driver.ts",
      "corpus": [
        {
          "path": "specs/apps/widget/behavior/widget-app/gherkin/checkout.feature",
          "scenarios": [
            {
              "name": "Checkout succeeds",
              "examples": 1,
              "steps": ["Given a cart with one item", "Then I see a receipt"]
            }
          ]
        }
      ],
      "bindings": [
        "specs/apps/widget/behavior/widget-app/gherkin/checkout.feature|Checkout succeeds|1|Given a cart with one item",
        "specs/apps/widget/behavior/widget-app/gherkin/checkout.feature|Checkout succeeds|1|Then I see a receipt"
      ]
    }
  }
}
