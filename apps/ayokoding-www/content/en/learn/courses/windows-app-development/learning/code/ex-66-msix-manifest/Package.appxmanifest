<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="WindowsTasks" Publisher="CN=OSE" Version="1.0.0.0" />
  <Properties>
    <DisplayName>Windows Tasks</DisplayName>
    <PublisherDisplayName>OSE</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Applications>
    <Application Id="App" Executable="WindowsTasks.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Windows Tasks" Description="Windows task manager" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
