<Window x:Class="WindowsTasks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Tasks" Height="360" Width="520">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox Grid.Row="0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
      <Button Content="Load" Command="{Binding LoadCommand}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
      <ProgressBar Value="{Binding Progress}" Maximum="100" Width="180" Margin="16,0,0,0" />
    </StackPanel>
    <ListView Grid.Row="2" ItemsSource="{Binding Tasks}" DisplayMemberPath="Title" />
    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Firebrick" />
  </Grid>
</Window>

