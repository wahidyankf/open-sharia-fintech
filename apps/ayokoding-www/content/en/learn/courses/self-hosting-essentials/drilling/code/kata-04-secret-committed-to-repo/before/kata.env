# kata-04 (before): an env file committed with a REAL secret (the hard-iron violation).
# THE BUG: a genuine signing secret is baked into a repo-tracked file. Git history
# is permanent, so this is leaked the moment the commit lands -- co-13's hard rule
# ("no secrets in git") is violated. This file should have been on .gitignore and
# should never have held a real value at all.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SIGNING_SECRET=5f3e9a8c2b1d4e7f0a6c9b3d8e2f1a4c7b0d3e6f9a2c5b8e1d4f7a0c3b6e9d2  # BUG: a real secret, in git
