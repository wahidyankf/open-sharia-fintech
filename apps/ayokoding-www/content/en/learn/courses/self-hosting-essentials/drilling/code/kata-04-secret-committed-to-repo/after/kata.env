# kata-04 (after): secrets live OUT OF BAND, never in the repo (co-13).
# THE FIX: this repo-tracked file holds ONLY non-secret tunables. The real secret
# lives in a SEPARATE, mode-0600, gitignored file (/opt/myapp/secrets.env) set out
# of band on the box (Example 16/21). The hard-iron rule is restored: the repo is
# clean, and 'git log' could never have seen the secret.
APP_HOST=127.0.0.1
APP_PORT=8000
# No secret here. The real APP_SIGNING_SECRET lives ONLY in:
#   /opt/myapp/secrets.env   (mode 0600, owned by deploy, listed in .gitignore)
# Set it out of band (Example 16), read it at runtime (Example 62 EnvironmentFile=-).
