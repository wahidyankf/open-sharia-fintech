{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ayokoding-www",
  "sourceRoot": "apps/ayokoding-www/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No codegen needed \u2014 ayokoding-www has no OpenAPI contract'",
        "cwd": "{projectRoot}"
      }
    },
    "generate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts",
        "cwd": "{projectRoot}"
      }
    },
    "validate-indexes": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts --validate",
        "cwd": "{projectRoot}"
      }
    },
    "generate-benchmark-reference": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-benchmark-reference.ts",
        "cwd": "{projectRoot}"
      }
    },
    "validate-benchmark-reference": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-benchmark-reference.ts --validate",
        "cwd": "{projectRoot}"
      }
    },
    "generate-search-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/features/search/shell/generate-search-data.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx src/scripts/generate-indexes.ts && node ../../scripts/next-with-port.mjs dev --env AYOKODING_WWW_PORT --default 3101",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["generate-indexes", "generate-search-data"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env AYOKODING_WWW_PORT --default 3101",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin .",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/specs/apps/ayokoding/**/*.feature"],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run --project unit --project unit-fe --testTimeout=60000",
        "cwd": "{projectRoot}"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --project unit --project unit-fe --coverage --coverage.thresholds.lines=82 --testTimeout=60000",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run ayokoding-www:typecheck",
          "npx nx run ayokoding-www:lint",
          "npx nx run ayokoding-www:test:unit",
          "npx nx run ayokoding-www:test:coverage",
          "npx nx run ayokoding-www:test:specs"
        ],
        "parallel": false
      },
      "inputs": ["default", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: integration tier not used for this content app'",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps --exclude-source-dir content specs/apps/ayokoding/behavior/ayokoding-www/gherkin specs/apps/ayokoding/behavior/ayokoding-be/gherkin specs/apps/ayokoding/behavior/ayokoding-build-tools/gherkin apps/ayokoding-www"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-www/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-be/gherkin/**/*.feature",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-build-tools/gherkin/**/*.feature",
        "{projectRoot}/**/*.{ts,tsx}"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ayokoding-www:specs:structure-validation",
          "npx nx run ayokoding-www:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    }
  },
  "namedInputs": {
    "specs": [
      "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-www/gherkin/**/*.feature",
      "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-be/gherkin/**/*.feature",
      "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-build-tools/gherkin/**/*.feature"
    ]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ayokoding"]
}
