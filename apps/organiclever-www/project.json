{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-www",
  "sourceRoot": "apps/organiclever-www/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs dev --env ORGANICLEVER_WWW_PORT --default 3200",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env ORGANICLEVER_WWW_PORT --default 3200",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin .",
        "cwd": "{projectRoot}"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/oxlint.json", "{projectRoot}/tsconfig.json"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/www/behaviors/frontend/**/*.feature"],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run",
        "cwd": "apps/organiclever-www"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/organiclever-www"
      },
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run organiclever-www:typecheck",
          "npx nx run organiclever-www:lint",
          "npx nx run organiclever-www:test:unit",
          "npx nx run organiclever-www:test:coverage",
          "npx nx run organiclever-www:test:specs",
          "npx nx run organiclever-www:test:layout:validation",
          "npx nx run organiclever-www:coverage:policy:validation",
          "npx nx run organiclever-www:package-manifest:policy:validation"
        ],
        "parallel": false
      },
      "inputs": ["default", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps specs/apps/organiclever/www/behaviors/frontend apps/organiclever-www",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/www/behaviors/frontend/**/*.feature",
        "{projectRoot}/**/*.{ts,tsx}"
      ]
    },
    "test:behavior:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project organiclever-www --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/www/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project organiclever-www --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/www/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project organiclever-www --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/www/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-www:test:behavior:coverage:unit",
          "npx nx run organiclever-www:test:behavior:coverage:integration",
          "npx nx run organiclever-www:test:behavior:coverage:e2e"
        ],
        "parallel": false
      },
      "dependsOn": ["test:behavior:coverage:unit", "test:behavior:coverage:integration", "test:behavior:coverage:e2e"],
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-www:specs:structure-validation",
          "npx nx run organiclever-www:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "test:layout:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract layout validate --project organiclever-www"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "coverage:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract coverage validate --project organiclever-www"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "package-manifest:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract manifest validate --project organiclever-www"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/www/behaviors/frontend/**/*.feature"]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["web-ui", "web-ui-token"]
}
