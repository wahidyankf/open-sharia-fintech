{
  "name": "ayokoding-cli",
  "sourceRoot": "apps/ayokoding-cli",
  "projectType": "application",
  "tags": ["type:app", "platform:cli", "lang:rust", "domain:ayokoding"],
  "implicitDependencies": ["rust-commons"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --manifest-path apps/ayokoding-cli/Cargo.toml && mkdir -p apps/ayokoding-cli/dist && cp apps/ayokoding-cli/target/release/ayokoding-cli apps/ayokoding-cli/dist/ayokoding-cli"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fetch --manifest-path apps/ayokoding-cli/Cargo.toml"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo fmt --manifest-path apps/ayokoding-cli/Cargo.toml -- --check",
          "cargo clippy --manifest-path apps/ayokoding-cli/Cargo.toml --all-targets -- -D warnings"
        ],
        "parallel": false
      }
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo deny --manifest-path apps/ayokoding-cli/Cargo.toml check"
      },
      "cache": false,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/Cargo.lock", "{projectRoot}/deny.toml"]
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo hack --manifest-path apps/ayokoding-cli/Cargo.toml check --rust-version"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --manifest-path apps/ayokoding-cli/Cargo.toml --"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path apps/ayokoding-cli/Cargo.toml --all-targets"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/ayokoding-cli/Cargo.toml --lib"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo llvm-cov --manifest-path apps/ayokoding-cli/Cargo.toml --lib --fail-under-lines 90"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs"],
      "outputs": ["{projectRoot}/lcov.info"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ayokoding-cli:typecheck",
          "npx nx run ayokoding-cli:lint",
          "npx nx run ayokoding-cli:test:unit",
          "npx nx run ayokoding-cli:test:coverage",
          "npx nx run ayokoding-cli:test:specs"
        ],
        "parallel": false
      },
      "cache": true
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/ayokoding-cli/Cargo.toml --tests"
      },
      "cache": true,
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/src/**/*.rs", "{projectRoot}/tests/**/*.rs"]
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs behavior-coverage validate --shared-steps specs/apps/ayokoding/behavior/ayokoding-cli/gherkin apps/ayokoding-cli"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.rs",
        "{projectRoot}/tests/**/*.rs",
        "{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-cli/gherkin/**/*.feature"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/apps/rhino-cli/src/**/*.rs", "{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ayokoding-cli:specs:structure-validation",
          "npx nx run ayokoding-cli:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ayokoding/behavior/ayokoding-cli/gherkin/**/*.feature"]
  }
}
