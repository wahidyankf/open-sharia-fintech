{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "beavernest-app",
  "sourceRoot": "apps/beavernest-app/lib",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter pub run openapi_spec generate --path ../../specs/apps/beavernest/containers/contracts/generated/openapi-bundled.yaml --destination lib/generated --package_name beavernest_api --force && fvm flutter pub run build_runner build --delete-conflicting-outputs",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["beavernest-contracts:bundle"],
      "cache": true,
      "inputs": [
        "default",
        "flutter-toolchain",
        "{workspaceRoot}/specs/apps/beavernest/containers/contracts/generated/openapi-bundled.yaml"
      ],
      "outputs": ["{projectRoot}/lib/generated"]
    },
    "build:web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter build web",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"],
      "outputs": ["{projectRoot}/build/web"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "true",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build:web"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"],
      "outputs": ["{projectRoot}/build/web"]
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter analyze",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter analyze",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter analyze",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter test test",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter test --coverage && cargo run --release --quiet --manifest-path ../../apps/rhino-cli/Cargo.toml -- test-coverage validate apps/beavernest-app/coverage/lcov.info 80 --exclude 'lib/generated/*/*.dart'",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["default", "flutter-toolchain"],
      "outputs": ["{projectRoot}/coverage/lcov.info"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "fvm flutter test integration_test -d chrome",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["codegen"],
      "cache": false
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npm exec nx run beavernest-app:specs:structure-validation"],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx run beavernest-app:analyze",
          "npm exec nx run beavernest-app:lint",
          "npm exec nx run beavernest-app:test:unit",
          "npm exec nx run beavernest-app:test:coverage",
          "npm exec nx run beavernest-app:specs:structure-validation"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": ["default", "flutter-toolchain", "{workspaceRoot}/specs/apps/**/*"]
    }
  },
  "namedInputs": {
    "flutter-toolchain": ["{workspaceRoot}/.fvmrc"]
  },
  "tags": ["type:app", "platform:flutter", "lang:dart", "domain:beavernest"],
  "implicitDependencies": ["beavernest-contracts", "rhino-cli"]
}
