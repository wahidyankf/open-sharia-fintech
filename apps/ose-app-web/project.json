{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ose-app-web",
  "sourceRoot": "apps/ose-app-web/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @hey-api/openapi-ts -i specs/apps/ose/be/contracts/generated/openapi-bundled.yaml -o apps/ose-app-web/src/generated-contracts -s && git diff --exit-code -- apps/ose-app-web/src/generated-contracts/"
      },
      "dependsOn": ["ose-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/ose/be/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/src/generated-contracts"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs dev --env OSE_APP_WEB_PORT --default 3300",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../scripts/next-with-port.mjs start --env OSE_APP_WEB_PORT --default 3300",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint --jsx-a11y-plugin . && npx eslint .",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/oxlint.json",
        "{projectRoot}/eslint.config.mjs",
        "{projectRoot}/tsconfig.json"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "{projectRoot}/src/generated-contracts/**/*"],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next --exclude-dir=dist --exclude-dir=coverage --exclude-dir=storybook-static '\\b(it|test|describe)\\.(skip|only|todo)\\(' .; then echo 'ERROR: .skip()/.only()/.todo() found in test files above - remove before merging'; exit 1; fi && npx vitest run",
        "cwd": "apps/ose-app-web"
      },
      "dependsOn": []
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --coverage --coverage.thresholds.lines=99",
        "cwd": "apps/ose-app-web"
      },
      "cache": true,
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tests/unit/**/*"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run ose-app-web:typecheck",
          "npx nx run ose-app-web:lint",
          "npx nx run ose-app-web:test:unit",
          "npx nx run ose-app-web:test:coverage",
          "npx nx run ose-app-web:test:specs",
          "npx nx run ose-app-web:test:layout:validation",
          "npx nx run ose-app-web:coverage:policy:validation",
          "npx nx run ose-app-web:package-manifest:policy:validation"
        ],
        "parallel": false
      },
      "inputs": ["default", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev -p 6006 --no-open",
        "cwd": "{projectRoot}"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npx storybook build -o storybook-static",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps specs/apps/ose/app-web/behaviors/smoke apps/ose-app-web-e2e",
          "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps specs/apps/ose/app-web/behaviors/env-loader apps/ose-app-web/tests/unit"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ose/app-web/behaviors/**/*.feature",
        "{workspaceRoot}/apps/ose-app-web-e2e/**/*.ts",
        "{projectRoot}/tests/unit/**/*.{ts,tsx}"
      ]
    },
    "test:behavior:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project ose-app-web --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ose/app-web/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project ose-app-web --adapter integration"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ose/app-web/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract bdd validate --project ose-app-web --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ose/app-web/behaviors/**/*.feature",
        "{workspaceRoot}/repo-config.yml",
        "default"
      ]
    },
    "test:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ose-app-web:test:behavior:coverage:unit",
          "npx nx run ose-app-web:test:behavior:coverage:integration",
          "npx nx run ose-app-web:test:behavior:coverage:e2e"
        ],
        "parallel": false
      },
      "dependsOn": ["test:behavior:coverage:unit", "test:behavior:coverage:integration", "test:behavior:coverage:e2e"],
      "cache": true
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ose-app-web:specs:structure-validation",
          "npx nx run ose-app-web:specs:behavior:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "test:layout:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract layout validate --project ose-app-web"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "coverage:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract coverage validate --project ose-app-web"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    },
    "package-manifest:policy:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract manifest validate --project ose-app-web"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ose/app-web/behaviors/**/*.feature"]
  },
  "tags": ["type:app", "platform:nextjs", "lang:ts", "domain:ose"],
  "implicitDependencies": ["ose-contracts", "web-ui", "web-ui-token"]
}
