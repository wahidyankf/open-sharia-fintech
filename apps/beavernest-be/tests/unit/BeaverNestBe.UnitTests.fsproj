<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <!-- 3261/3264: F# nullness interop noise in test data.
         0044: the in-process Giraffe TestServer harness (WebHostBuilder/TestServer
         in Steps/BddState.fs) is deprecated in ASP.NET 10 but remains the standard,
         working pattern for Giraffe in-process unit testing. Suppressing is intentional. -->
    <OtherFlags>--nowarn:3261 --nowarn:3264 --nowarn:0044</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Steps/BddState.fs" />
    <Compile Include="Steps/HealthSteps.fs" />
    <Compile Include="Steps/ReadinessSteps.fs" />
    <Compile Include="Steps/NotFoundSteps.fs" />
    <Compile Include="Steps/RoutingSteps.fs" />
    <Compile Include="Steps/PersistenceSteps.fs" />
    <Compile Include="Steps/RecoverySteps.fs" />
    <Compile Include="Steps/DevelopmentSteps.fs" />
    <Compile Include="Steps/ConfigurationSteps.fs" />
    <Compile Include="Tests/HealthHandlerTests.fs" />
    <Compile Include="Tests/ReadinessHandlerTests.fs" />
    <Compile Include="Tests/DiagnosticsHandlerTests.fs" />
    <Compile Include="Tests/NotFoundHandlerTests.fs" />
    <Compile Include="Tests/HttpMethodSemanticsTests.fs" />
    <Compile Include="Tests/StaticRoutingTests.fs" />
    <Compile Include="Tests/SecurityHeaderTests.fs" />
    <Compile Include="Tests/HttpConfigurationTests.fs" />
    <Compile Include="Tests/DatabaseConfigurationTests.fs" />
    <Compile Include="Tests/SqliteInfrastructureTests.fs" />
    <Compile Include="Tests/DatabaseOperationsTests.fs" />
    <Compile Include="Tests/EnvTierLoaderTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures/flutter/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to match ../../src/BeaverNestBe/BeaverNestBe.fsproj's pin: G-Research.FSharp.Analyzers
         there requires FSharp.Core >= 10.1.302, above this project's own SDK-implicit floor, and
         the mismatch surfaces as an NU1605 package-downgrade error via the ProjectReference below. -->
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="TickSpec" Version="2.0.5" />
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BeaverNestBe/BeaverNestBe.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Disables collection parallelism: EnvTierLoaderTests mutates the process-wide
         current directory, which DatabaseConfigurationTests reads. See the comment at
         the top of Tests/DatabaseConfigurationTests.fs. -->
    <None Include="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
