# Integration test runner for beavernest-be.
# Build context is the monorepo root (../../ relative to this file, per docker-compose.integration.yml).
# Generate the F# OpenAPI model from source so a clean checkout never depends
# on ignored host artifacts.
FROM node:24.16.0-alpine3.23@sha256:2bdb65ed1dab192432bc31c95f94155ca5ad7fc1392fb7eb7526ab682fa5bf14 AS contract-build
WORKDIR /workspace

RUN apk add --no-cache openjdk17-jre-headless

COPY package.json package-lock.json nx.json openapitools.json tsconfig.base.json ./
RUN npm ci --include-workspace-root --ignore-scripts

COPY specs/apps/beavernest/containers/contracts/ specs/apps/beavernest/containers/contracts/
RUN npx @redocly/cli bundle specs/apps/beavernest/containers/contracts/openapi.yaml \
    -o specs/apps/beavernest/containers/contracts/generated/openapi-bundled.yaml \
  && npx openapi-generator-cli generate \
    -i specs/apps/beavernest/containers/contracts/generated/openapi-bundled.yaml \
    -g fsharp-giraffe-server \
    -o apps/beavernest-be/generated-contracts \
    --model-package BeaverNestBe.Contracts \
    --global-property=models,modelDocs=false,apiDocs=false

FROM mcr.microsoft.com/dotnet/sdk:10.0.302-noble@sha256:72dd743782f2ae7e5476fd64f6a460045e3998dc862218b80e6944cba79a01b0

WORKDIR /build

# Docker Compose supplies the same explicit, sanitized values and mounts this
# directory as tmpfs. Keeping defaults here makes direct image execution use a
# disposable database and loopback-only listener as well.
ENV BEAVERNEST_BE_DATA_DIRECTORY=/tmp/beavernest-integration \
    BEAVERNEST_BE_HTTP_LISTEN_ADDRESS=127.0.0.1 \
    BEAVERNEST_BE_HTTP_LISTEN_PORT=19320 \
    BEAVERNEST_BE_SQLITE_BUSY_TIMEOUT_MILLISECONDS=1000

# Copy solution-level files first for dependency caching.
COPY apps/beavernest-be/global.json .
COPY apps/beavernest-be/dotnet-tools.json .
COPY apps/beavernest-be/.editorconfig .

# Copy project files for restore (before code to cache the restore layer).
COPY apps/beavernest-be/src/BeaverNestBe/BeaverNestBe.fsproj src/BeaverNestBe/
COPY apps/beavernest-be/tests/integration/BeaverNestBe.IntegrationTests.fsproj tests/integration/
COPY libs/fsharp-env-loader/fsharp-env-loader.fsproj /libs/fsharp-env-loader/

RUN dotnet restore tests/integration/BeaverNestBe.IntegrationTests.fsproj

# Copy source and test code.
COPY apps/beavernest-be/src/ src/
COPY apps/beavernest-be/tests/integration/ tests/integration/
COPY libs/fsharp-env-loader/src/ /libs/fsharp-env-loader/src/
COPY --from=contract-build /workspace/apps/beavernest-be/generated-contracts/OpenAPI/src/BeaverNestBe.Contracts/Health.fs generated-contracts/OpenAPI/src/BeaverNestBe.Contracts/Health.fs

# Build the test project (restore already ran; --no-restore keeps the layer cache useful).
RUN dotnet build tests/integration/BeaverNestBe.IntegrationTests.fsproj --no-restore

# HostBootTests.fs boots the real Kestrel host in-process and calls it over HTTP —
# no external services (DB, message bus) required.
CMD ["dotnet", "test", "tests/integration/BeaverNestBe.IntegrationTests.fsproj", "--no-build", "--logger", "console;verbosity=normal"]
