<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BeaverNestBe</AssemblyName>
    <RootNamespace>BeaverNestBe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <OtherFlags>--warnon:1182 --nowarn:3261 --nowarn:3264 --nowarn:3511</OtherFlags>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <!-- G-Research F# Analyzers: treat all violations as errors in build -->
    <FSharpAnalyzersOtherFlags>--analyzers-path &quot;$(PkgG-Research_FSharp_Analyzers)/analyzers/dotnet/fs&quot; --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001 --verbosity d</FSharpAnalyzersOtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated contract types from the OpenAPI spec (generated-contracts/, gitignored).
         Only Health.fs is wired: ReadinessReady.fs/ReadinessUnavailable.fs generate their
         status/component fields as single-case-DU-wrapped enums with no established JSON
         converter in this codebase, so wiring them without one would silently change the
         wire format the Gherkin/contract suite already tests against. Error.fs is excluded
         for the same documented reason the sibling backends exclude it (generator emits a
         broken `_Error` field name for a property called `error`) — see Domain/ErrorBody.fs. -->
    <Compile Include="..\..\generated-contracts\OpenAPI\src\BeaverNestBe.Contracts\Health.fs" />
    <Compile Include="Domain/HttpConfiguration.fs" />
    <Compile Include="Domain/DatabaseConfiguration.fs" />
    <Compile Include="Domain/Readiness.fs" />
    <Compile Include="Domain/ErrorBody.fs" />
    <Compile Include="Infrastructure/Sqlite/Errors.fs" />
    <Compile Include="Infrastructure/Sqlite/Connection.fs" />
    <Compile Include="Infrastructure/Migrations.fs" />
    <Compile Include="Infrastructure/EnvTierLoader.fs" />
    <Compile Include="Operations/Database.fs" />
    <Compile Include="Application/ReadinessPort.fs" />
    <Compile Include="Api/HealthHandlers.fs" />
    <Compile Include="Api/ReadinessHandlers.fs" />
    <Compile Include="Api/SecurityHeaders.fs" />
    <Compile Include="Api/StaticContent.fs" />
    <!-- Composition root -->
    <Compile Include="WebApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned explicitly: the SDK's implicit FSharp.Core reference resolved a different
         version (10.1.300 vs 10.1.302) depending on whether the invoking dotnet command hit
         the local NuGet cache or a fresh network listing, causing restores to flip-flop and
         intermittently fail downstream tools (fsharplint) that expect a stable lock. -->
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
    <PackageReference Include="Giraffe" Version="8.2.0" />
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- F# static analyzers (G-Research) — runs via dotnet msbuild /t:AnalyzeFSharpProject -->
    <PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="0.22.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../libs/fsharp-env-loader/fsharp-env-loader.fsproj" />
  </ItemGroup>

</Project>
