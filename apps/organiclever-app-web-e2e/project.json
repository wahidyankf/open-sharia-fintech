{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "organiclever-app-web-e2e",
  "sourceRoot": "apps/organiclever-app-web-e2e/steps",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright install --with-deps chromium",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/app-web/behaviors/**/*.feature"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run organiclever-app-web-e2e:typecheck",
          "npx nx run organiclever-app-web-e2e:lint",
          "npx nx run organiclever-app-web-e2e:test:unit",
          "npx nx run organiclever-app-web-e2e:test:coverage",
          "npx nx run organiclever-app-web-e2e:test:specs"
        ],
        "parallel": false
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/organiclever/app-web/behaviors/**/*.feature"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npx bddgen && PLAYWRIGHT_GREP_INVERT=@local-fullstack npx playwright test",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "{projectRoot}"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "specs:e2e:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && dotnet run --project ../../apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs e2e-coverage validate --project organiclever-app-web-e2e --features \"../../specs/apps/organiclever/app-web/behaviors/**/*.feature\" --features-gen .features-gen --baseline e2e-coverage-baseline.json",
        "cwd": "apps/organiclever-app-web-e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/app-web/behaviors/**/*.feature",
        "{projectRoot}/steps/**/*.steps.ts",
        "{projectRoot}/playwright.config.ts",
        "{projectRoot}/e2e-coverage-baseline.json"
      ]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-app-web-e2e:specs:structure-validation",
          "npx nx run organiclever-app-web-e2e:specs:behavior:coverage",
          "npx nx run organiclever-app-web-e2e:specs:e2e:coverage"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:organiclever"],
  "implicitDependencies": ["organiclever-app-web", "organiclever-be"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/app-web/behaviors/**/*.feature"]
  }
}
