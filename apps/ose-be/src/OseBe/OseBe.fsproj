<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OseBe</AssemblyName>
    <RootNamespace>OseBe</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <OtherFlags>--warnon:1182 --nowarn:3261 --nowarn:3264 --nowarn:3511</OtherFlags>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
    <!-- G-Research F# Analyzers: treat all violations as errors in build -->
    <FSharpAnalyzersOtherFlags>--analyzers-path &quot;$(PkgG-Research_FSharp_Analyzers)/analyzers/dotnet/fs&quot; --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-LOGTEMPLMISSVALS-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001 --verbosity d</FSharpAnalyzersOtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated contract types from OpenAPI spec (generated-contracts/, gitignored).
         Only the usable models are wired; ErrorResponse.fs is generated but excluded
         (it references an AnyType module the generator does not emit). -->
    <Compile Include="..\..\generated-contracts\OpenAPI\src\OseBe.Contracts\HealthResponse.fs" />
    <!-- Shared domain (the only cross-context coupling) -->
    <Compile Include="Domain/Readiness.fs" />
    <!-- Shared infrastructure: EF Core context + repositories + OpenRouter + DbUp config + NATS -->
    <Compile Include="Infrastructure/AppDbContext.fs" />
    <Compile Include="Infrastructure/Repositories/RepositoryTypes.fs" />
    <Compile Include="Infrastructure/Repositories/EfRepositories.fs" />
    <Compile Include="Infrastructure/OpenRouterClient.fs" />
    <Compile Include="Infrastructure/OpenRouterConnect.fs" />
    <Compile Include="Infrastructure/Database.fs" />
    <Compile Include="Infrastructure/NatsClient.fs" />
    <Compile Include="Infrastructure/NatsConnect.fs" />
    <!-- config context (tiered .env.<APP_ENV> loader) -->
    <Compile Include="Contexts/Config/Infrastructure/EnvTier.fs" />
    <!-- db context (DbUp migration routine) -->
    <Compile Include="Contexts/Db/Infrastructure/DbMigrations.fs" />
    <Compile Include="Contexts/Db/Application/MigrationStatus.fs" />
    <Compile Include="Contexts/Db/Api/MigrationStatusApi.fs" />
    <!-- health context slice -->
    <Compile Include="Contexts/Health/Domain/HealthDomain.fs" />
    <Compile Include="Contexts/Health/Application/HealthService.fs" />
    <Compile Include="Contexts/Health/Infrastructure/HealthInfrastructure.fs" />
    <Compile Include="Contexts/Health/Api/HealthApi.fs" />
    <!-- regulatory-source context slice -->
    <Compile Include="Contexts/RegulatorySource/Domain/RegulatorySourceDomain.fs" />
    <Compile Include="Contexts/RegulatorySource/Application/RegulatorySourceService.fs" />
    <Compile Include="Contexts/RegulatorySource/Infrastructure/RegulatorySourceInfrastructure.fs" />
    <Compile Include="Contexts/RegulatorySource/Api/RegulatorySourceApi.fs" />
    <!-- internal-policy context slice -->
    <Compile Include="Contexts/InternalPolicy/Domain/InternalPolicyDomain.fs" />
    <Compile Include="Contexts/InternalPolicy/Application/InternalPolicyService.fs" />
    <Compile Include="Contexts/InternalPolicy/Infrastructure/InternalPolicyInfrastructure.fs" />
    <Compile Include="Contexts/InternalPolicy/Api/InternalPolicyApi.fs" />
    <!-- gap-analysis context slice -->
    <Compile Include="Contexts/GapAnalysis/Domain/GapAnalysisDomain.fs" />
    <Compile Include="Contexts/GapAnalysis/Application/GapAnalysisService.fs" />
    <Compile Include="Contexts/GapAnalysis/Infrastructure/GapAnalysisInfrastructure.fs" />
    <Compile Include="Contexts/GapAnalysis/Api/GapAnalysisApi.fs" />
    <!-- ai-orchestration context slice -->
    <Compile Include="Contexts/AiOrchestration/Domain/AiOrchestrationDomain.fs" />
    <Compile Include="Contexts/AiOrchestration/Application/AiOrchestrationService.fs" />
    <Compile Include="Contexts/AiOrchestration/Infrastructure/AiOrchestrationInfrastructure.fs" />
    <Compile Include="Contexts/AiOrchestration/Api/AiOrchestrationApi.fs" />
    <!-- messaging context slice -->
    <Compile Include="Contexts/Messaging/Domain/MessagingDomain.fs" />
    <Compile Include="Contexts/Messaging/Application/MessagingStatus.fs" />
    <Compile Include="Contexts/Messaging/Infrastructure/JetStreamDemo.fs" />
    <Compile Include="Contexts/Messaging/Api/MessagingApi.fs" />
    <!-- Composition root -->
    <Compile Include="WebApp.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Giraffe" Version="8.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.6" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="dbup-core" Version="6.1.1" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="NATS.Net" Version="2.7.3" />
    <!-- F# static analyzers (G-Research) — runs via dotnet msbuild /t:AnalyzeFSharpProject -->
    <PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="0.22.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../libs/fsharp-env-loader/fsharp-env-loader.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\db\migrations\*.sql">
      <Link>db/migrations/%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
