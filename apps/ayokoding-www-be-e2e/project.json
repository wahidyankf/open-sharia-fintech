{
  "name": "ayokoding-www-be-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ayokoding-www-be-e2e/tests",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run ayokoding-www-be-e2e:typecheck",
          "npx nx run ayokoding-www-be-e2e:lint",
          "npx nx run ayokoding-www-be-e2e:test:unit",
          "npx nx run ayokoding-www-be-e2e:test:coverage",
          "npx nx run ayokoding-www-be-e2e:test:specs",
          "npx nx run ayokoding-www-be-e2e:test:layout:validation"
        ],
        "parallel": false
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/specs/apps/ayokoding/www/behaviors/backend/**/*.feature"],
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npx bddgen && npx playwright test",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && npx playwright test --ui",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "apps/ayokoding-www-be-e2e"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "specs:e2e:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && dotnet run --project ../../apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs e2e-coverage validate --project ayokoding-www-be-e2e --features \"../../specs/apps/ayokoding/www/behaviors/backend/**/*.feature\" --features-gen .features-gen --baseline e2e-coverage-baseline.json",
        "cwd": "apps/ayokoding-www-be-e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/ayokoding/www/behaviors/backend/**/*.feature",
        "{projectRoot}/tests/integration/steps/**/*.steps.ts",
        "{projectRoot}/playwright.config.ts",
        "{projectRoot}/e2e-coverage-baseline.json"
      ]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run ayokoding-www-be-e2e:specs:structure-validation",
          "npx nx run ayokoding-www-be-e2e:specs:behavior:coverage",
          "npx nx run ayokoding-www-be-e2e:specs:e2e:coverage"
        ],
        "parallel": false
      },
      "cache": true
    },
    "test:layout:validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/rhino-cli/scripts/rhino-bin.sh test-contract layout validate --project ayokoding-www-be-e2e"
      },
      "cache": true,
      "inputs": ["default", "{projectRoot}/project.json"]
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:ayokoding"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/ayokoding/www/behaviors/frontend/**/*.feature"]
  }
}
