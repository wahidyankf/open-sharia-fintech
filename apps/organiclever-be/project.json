{
  "name": "organiclever-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/organiclever-be/src",
  "projectType": "application",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx openapi-generator-cli generate -i $(pwd)/specs/apps/organiclever/containers/contracts/generated/openapi-bundled.yaml -g fsharp-giraffe-server -o $(pwd)/apps/organiclever-be/generated-contracts --model-package OrganicleverBe.Contracts --global-property=models,modelDocs=false,apiDocs=false"
      },
      "dependsOn": ["organiclever-contracts:bundle"],
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/organiclever/containers/contracts/generated/openapi-bundled.yaml"],
      "outputs": ["{projectRoot}/generated-contracts"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj -c Release -o apps/organiclever-be/dist"
      },
      "dependsOn": ["codegen"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OrganicleverBe/OrganicleverBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/src/OrganicleverBe/OrganicleverBe.fsproj",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/generated-contracts/**/*.fs"
      ]
    },
    "lint": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "dotnet tool restore",
          "dotnet tool run fantomas --check apps/organiclever-be/src",
          "dotnet fsharplint lint apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj --lint-config apps/organiclever-be/fsharplint.json",
          "dotnet fsharp-analyzers --project apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj --analyzers-path $(find $(dotnet nuget locals global-packages --list | sed 's/.*: //')g-research.fsharp.analyzers -path '*/analyzers/dotnet/fs' -type d | head -1) --treat-as-error GRA-STRING-001 GRA-STRING-002 GRA-STRING-003 GRA-STRING-004 GRA-UNIONCASE-001 GRA-VIRTUALCALL-001 GRA-JSONOPTS-001 GRA-DISPBEFOREASYNC-001 GRA-IMMUTABLECOLLECTIONEQUALITY-001 GRA-LOGARGFUNCFULLAPP-001 GRA-TYPE-ANNOTATE-001 GRA-INTERPOLATED-001"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/src/OrganicleverBe/OrganicleverBe.fsproj"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet watch run --project apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj"
      }
    },
    "test:unit": {
      "dependsOn": ["codegen", "typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.fs' 'Skip\\s*=' apps/organiclever-be/tests/unit; then echo 'ERROR: xunit Skip= attribute found in test files above'; exit 1; fi && dotnet test apps/organiclever-be/tests/unit/OrganicleverBe.UnitTests.fsproj"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.fs",
        "{projectRoot}/tests/unit/**/*.fs",
        "{projectRoot}/src/OrganicleverBe/OrganicleverBe.fsproj"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/organiclever-be/tests/unit/OrganicleverBe.UnitTests.fsproj --collect:\"XPlat Code Coverage\" /p:Threshold=80 /p:ThresholdType=line"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.fs", "{projectRoot}/tests/unit/**/*.fs"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-be:typecheck",
          "npx nx run organiclever-be:lint",
          "npx nx run organiclever-be:test:unit",
          "npx nx run organiclever-be:test:coverage",
          "npx nx run organiclever-be:test:specs"
        ],
        "parallel": false
      },
      "dependsOn": ["typecheck", "lint"],
      "cache": true,
      "inputs": ["default", "specs"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/organiclever-be/scripts/run-integration.sh"
      },
      "cache": false
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs behavior-coverage validate --shared-steps --exclude-dir messaging specs/apps/organiclever/behavior/organiclever-be/gherkin apps/organiclever-be"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-be/gherkin/**/*.feature",
        "{projectRoot}/src/**/*.fs"
      ]
    },
    "specs:domain:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs domain-coverage validate --shared-steps --exclude-dir messaging specs/apps/organiclever/behavior/organiclever-be/gherkin apps/organiclever-be"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-be/gherkin/**/*.feature",
        "{projectRoot}/src/**/*.fs"
      ]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet list apps/organiclever-be/src/OrganicleverBe/OrganicleverBe.fsproj package --vulnerable"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for F#'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run organiclever-be:specs:structure-validation",
          "npx nx run organiclever-be:specs:behavior:coverage",
          "npx nx run organiclever-be:specs:domain:coverage"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "specs"]
    }
  },
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/organiclever/behavior/organiclever-be/gherkin/**/*.feature"]
  },
  "tags": ["type:app", "platform:giraffe", "lang:fsharp", "domain:organiclever"],
  "implicitDependencies": ["organiclever-contracts"]
}
