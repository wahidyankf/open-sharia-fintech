# ose-www — environment variable template
# Copy to .env.local for local development; never commit real secrets.

# OPTIONAL | string | Absolute path to content directory (default: apps/ose-www/content)
# OSE_WEB_CONTENT_DIR=

# OPTIONAL | string | Absolute path to generated search data (default: apps/ose-www/generated/search-data.json)
# OSE_WEB_SEARCH_DATA_PATH=

# OPTIONAL | boolean | Include draft posts in listing; set to "true" to enable (default: false)
# OSE_WEB_SHOW_DRAFTS=

# OPTIONAL | string | Next.js dev-server hostname (framework-reserved name; default: 0.0.0.0)
# HOSTNAME=0.0.0.0

# OPTIONAL | u16 | Listener port (default: 3100)
# Format: `--port` flag first, then this variable, then the default; a bare PORT is not honoured
# OSE_WWW_PORT=3100
