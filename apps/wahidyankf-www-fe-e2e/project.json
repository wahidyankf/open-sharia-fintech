{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "wahidyankf-www-fe-e2e",
  "sourceRoot": "apps/wahidyankf-www-fe-e2e/steps",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright install --with-deps chromium",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/wahidyankf/behavior/wahidyankf-www/gherkin/**/*.feature"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx oxlint .",
        "cwd": "{projectRoot}"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx nx run wahidyankf-www-fe-e2e:typecheck",
          "npx nx run wahidyankf-www-fe-e2e:lint",
          "npx nx run wahidyankf-www-fe-e2e:test:unit",
          "npx nx run wahidyankf-www-fe-e2e:test:coverage",
          "npx nx run wahidyankf-www-fe-e2e:test:specs"
        ],
        "parallel": false
      },
      "inputs": ["default", "{workspaceRoot}/specs/apps/wahidyankf/behavior/wahidyankf-www/gherkin/**/*.feature"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && node scripts/run-docker-e2e.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/run-docker-e2e.mjs --ui",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright show-report",
        "cwd": "{projectRoot}"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "specs:behavior:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'no-op: target not applicable for this project'"
      },
      "cache": true
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'compat:min-version: no standard min-version floor for TypeScript'"
      },
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run --release --quiet --manifest-path apps/rhino-cli/Cargo.toml -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "specs:e2e:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx bddgen && cargo run --release --quiet --manifest-path ../../apps/rhino-cli/Cargo.toml -- specs e2e-coverage validate --project wahidyankf-www-fe-e2e --features \"../../specs/apps/wahidyankf/behavior/wahidyankf-www/gherkin/**/*.feature\" --features-gen .features-gen --baseline e2e-coverage-baseline.json",
        "cwd": "apps/wahidyankf-www-fe-e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/wahidyankf/behavior/wahidyankf-www/gherkin/**/*.feature",
        "{projectRoot}/steps/**/*.ts",
        "{projectRoot}/playwright.config.ts",
        "{projectRoot}/e2e-coverage-baseline.json"
      ]
    },
    "test:specs": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run wahidyankf-www-fe-e2e:specs:structure-validation",
          "npx nx run wahidyankf-www-fe-e2e:specs:behavior:coverage",
          "npx nx run wahidyankf-www-fe-e2e:specs:e2e:coverage"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "tags": ["type:e2e", "platform:playwright", "lang:ts", "domain:wahidyankf"],
  "implicitDependencies": ["wahidyankf-www"],
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/wahidyankf/behavior/wahidyankf-www/gherkin/**/*.feature"]
  }
}
