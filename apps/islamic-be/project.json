{
  "name": "islamic-be",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/islamic-be",
  "projectType": "application",
  "namedInputs": {
    "specs": ["{workspaceRoot}/specs/apps/islamic/be/behaviours/**/*.feature"]
  },
  "tags": ["type:app", "platform:gin", "lang:go", "domain:islamic"],
  "implicitDependencies": ["islamic-contracts"],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go tool oapi-codegen -config oapi-codegen.yaml ../../specs/apps/islamic/be/contracts/generated/openapi-bundled.yaml"
      },
      "dependsOn": ["islamic-contracts:bundle"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/specs/apps/islamic/be/contracts/**",
        "{projectRoot}/oapi-codegen.yaml",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ],
      "outputs": ["{projectRoot}/generated-contracts/api.gen.go"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go build -o dist/islamic-be ./cmd/islamic-be"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go build ./..."
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "golangci-lint run"
      },
      "dependsOn": ["codegen"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/.golangci.yml", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go run ./cmd/islamic-be"
      },
      "dependsOn": ["codegen"],
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go run ./cmd/islamic-be"
      },
      "dependsOn": ["codegen"],
      "cache": false
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn -E --include='*.go' 't.Skip\\(|t.Skipf\\(' apps/islamic-be; then echo 'ERROR: skipped Go test found in the files above'; exit 1; fi && COVERAGE_MINIMUM=99 apps/islamic-be/scripts/coverage-gate.sh"
      },
      "dependsOn": ["codegen", "typecheck"],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/scripts/coverage-gate.sh",
        "specs"
      ]
    },
    "test:coverage:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/islamic-be/behaviour-coverage.json --adapter unit"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/islamic-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "specs",
        "{projectRoot}/internal/bdd/**/*.go",
        "{workspaceRoot}/apps/islamic-be-e2e/steps/**/*.ts",
        "{workspaceRoot}/apps/islamic-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/islamic-be/behaviour-coverage.json --adapter behaviour"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/islamic-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "specs",
        "{projectRoot}/internal/bdd/**/*.go",
        "{workspaceRoot}/apps/islamic-be-e2e/steps/**/*.ts",
        "{workspaceRoot}/apps/islamic-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/behaviour-coverage.mjs --config apps/islamic-be/behaviour-coverage.json --adapter e2e"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/behaviour-coverage.mjs",
        "{workspaceRoot}/apps/islamic-be/behaviour-coverage.json",
        "{workspaceRoot}/package-lock.json",
        "specs",
        "{projectRoot}/internal/bdd/**/*.go",
        "{workspaceRoot}/apps/islamic-be-e2e/steps/**/*.ts",
        "{workspaceRoot}/apps/islamic-be-e2e/playwright.config.ts"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["echo 'islamic-be coverage validators complete'"]
      },
      "dependsOn": ["test:coverage:unit", "test:coverage:e2e", "test:coverage:behaviour"],
      "cache": true
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["echo 'islamic-be test:quick complete'"]
      },
      "dependsOn": ["typecheck", "lint", "test:unit", "specs:structure-validation", "test:coverage"],
      "cache": true
    },
    "specs:structure-validation": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/rhino-cli/src/RhinoCli.Program/RhinoCli.Program.fsproj -- specs structure validate"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/specs/apps/!(rhino)/**/*"]
    },
    "deps:audit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/islamic-be",
        "command": "go list -m -u all"
      },
      "cache": false
    },
    "compat:min-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/islamic-be/scripts/compat-min-version.sh"
      },
      "cache": true,
      "inputs": ["{projectRoot}/go.mod", "{projectRoot}/scripts/compat-min-version.sh"]
    }
  }
}
